{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ReverseProxy": {
    "Routes": {
      "catalog": {
        "ClusterId": "eventCatalog",
        "Match": { "Path": "/api/{**remainder}" },
        "Transforms": [{ "PathRemovePrefix": "/api" }]
      },
      "booking": {
        "ClusterId": "booking",
        "Match": { "Path": "/booking-api/{**remainder}" },
        "Transforms": [{ "PathRemovePrefix": "/booking-api" }]
      },
      "tickets": {
        "ClusterId": "ticketService",
        "Match": { "Path": "/ticket-api/{**remainder}" },
        "Transforms": [{ "PathRemovePrefix": "/ticket-api" }]
      },
      "payments": {
        "ClusterId": "paymentSimulator",
        "Match": { "Path": "/payment-api/{**remainder}" },
        "Transforms": [{ "PathRemovePrefix": "/payment-api" }]
      }
    },
    "Clusters": {
      "eventCatalog": {
        "Destinations": {
          "primary": { "Address": "http://localhost:5080/" }
        }
      },
      "booking": {
        "Destinations": {
          "primary": { "Address": "http://localhost:5081/" }
        }
      },
      "ticketService": {
        "Destinations": {
          "primary": { "Address": "http://localhost:8082/" }
        }
      },
      "paymentSimulator": {
        "Destinations": {
          "primary": { "Address": "http://localhost:5111/" }
        }
      }
    }
  }
}