# Kopiera till .env i projektets rot för lokal utveckling på macOS/Linux.
# På Windows används semikolon mellan Compose-filerna.
COMPOSE_FILE=src/Compose.yaml:src/Compose.dev.yaml
# Ersätt med en egen genererad nyckel. Samma värde används av Booking och TicketService.
TICKET_SERVICE_INTERNAL_API_KEY=
