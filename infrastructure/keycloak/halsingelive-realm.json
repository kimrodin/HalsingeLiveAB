{
  "realm": "halsingelive",
  "displayName": "Hälsinge Live",
  "enabled": true,
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "loginWithEmailAllowed": true,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Hantera lokaler, sektioner och evenemang i admin-webben."
      }
    ]
  },
  "clients": [
    {
      "clientId": "admin-web",
      "name": "Hälsinge Live Admin",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "redirectUris": ["http://localhost:5173/*"],
      "webOrigins": ["http://localhost:5173"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*"
      },
      "defaultClientScopes": ["profile", "email"],
      "protocolMappers": [
        {
          "name": "eventcatalog-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "eventcatalog",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "app-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "realm_access.roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
  "scopeMappings": [
    {
      "client": "admin-web",
      "roles": ["admin"]
    }
  ],
  "users": [
    {
      "username": "testadmin",
      "enabled": true,
      "firstName": "Local",
      "lastName": "Administrator",
      "email": "testadmin@example.test",
      "emailVerified": true,
      "realmRoles": ["admin"],
      "credentials": [
        {
          "type": "password",
          "value": "testadmin",
          "temporary": false
        }
      ],
      "requiredActions": []
    }
  ]
}
